  },
  "dependencies": {
    "fflate": "^0.8.2",
    "preact": "^10.26.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.0.0"
  }
}
