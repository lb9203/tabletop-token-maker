{
  "name": "tabletop-token-maker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/frameMask.test.ts",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
